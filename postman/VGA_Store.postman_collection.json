                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories/active",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories",
                "active"
              ]
            }
          }
        }
      ]
